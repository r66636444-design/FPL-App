# Optional: enables grounded, natural-language answers; without it there is a useful deterministic coach.
# Never expose API keys in NEXT_PUBLIC_ variables or commit .env.local.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Optional: PostgreSQL persists scheduled news ingestion. Core website works without it.
DATABASE_URL=

# Required for scheduled /api/cron ingestion (Bearer token); use a long random value.
CRON_SECRET=